// Cloudflare Pages, direct upload, deployed by GitHub Actions.
// Pages projects use pages_build_output_dir; there is no assets/main block.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kwook-demo",
  "compatibility_date": "2026-08-30",
  "pages_build_output_dir": "./dist"
}
